{
  "expo": {
    "name": "kotes",
    "slug": "kotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kotes",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbe3e9",
    "platforms": ["android", "web"],
    "android": {
      "package": "com.kotes",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fff6f7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff6f7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/dmserif-400.ttf",
            "./assets/fonts/dmserif-400-italic.ttf",
            "./assets/fonts/garamond-400.ttf",
            "./assets/fonts/garamond-400-italic.ttf",
            "./assets/fonts/garamond-500.ttf",
            "./assets/fonts/garamond-500-italic.ttf",
            "./assets/fonts/manrope-400.ttf",
            "./assets/fonts/manrope-500.ttf",
            "./assets/fonts/manrope-600.ttf",
            "./assets/fonts/manrope-700.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
