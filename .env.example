# Copy to .env (Docker) or .env.local (development). Server-side only.

# ── Database ────────────────────────────────────────────────
# The app's own login: the least-privilege `kotes_app` role (supabase/app-role.sql).
# In Docker / on IPv4 networks use the Session pooler:
#   postgresql://kotes_app.<project-ref>:<APP_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Admin login (`postgres`), only for `npm run db:apply`. Keep it OFF the app server.
# Percent-encode special characters in the password ('#' → %23).
DATABASE_ADMIN_URL=
# Password for kotes_app; db:apply sets it on the role. 24+ random characters:
#   node -e "console.log(require('crypto').randomBytes(30).toString('base64url'))"
APP_DB_PASSWORD=

# ── Auth ────────────────────────────────────────────────────
# Any random string of 32+ characters (same command as above).
AUTH_SECRET=
# Cloudflare Turnstile (Cloudflare dashboard → Turnstile → Add widget). Empty = off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Play Integrity: the Android app's human check. Empty = the app falls
# back to Turnstile, which it can't pass, so set these before releasing the app.
#   Google Cloud project number (Cloud console → project settings), linked in
#   Play Console → App integrity:
PLAY_INTEGRITY_PROJECT_NUMBER=
#   A service account key for that project (Play Integrity API enabled), as
#   base64 of the JSON key file:
#   node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
PLAY_INTEGRITY_SERVICE_ACCOUNT=
# PLAY_INTEGRITY_ALLOW_TEST_BUILDS=1   # development servers only: lets dev builds and emulators sign in

# Google Play review: reviewers can't receive emails, so this one account signs
# in with a fixed 6-digit code (no email is sent). Give both to Play Console →
# App content → App access. Google reviews every update, so keep it while the
# app is listed; change the code if it ever leaks. Empty = off.
# REVIEW_EMAIL=review@kotes.mayurmundankar.com
# REVIEW_CODE=


# ── Email ───────────────────────────────────────────────────
# Resend (resend.com/api-keys). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=kotes <code@your-domain.com>

# ── Optional ────────────────────────────────────────────────
# MAX_CODES_PER_HOUR=300      # global cap on sign-in emails, protects your Resend quota
# DATABASE_POOL_MAX=5
# SITE_URL=https://kotes.mayurmundankar.com   # used in link previews, read at build time
