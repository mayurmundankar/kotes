# Copy to .env.local. Server-side only — nothing here reaches the browser.

# Supabase → Connect. Locally the direct connection works if you have IPv6.
# In Docker / on IPv4 networks use the Session pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Percent-encode special characters in the password ('#' → %23).
DATABASE_URL=

# Any random string of 32+ characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Resend (resend.com/api-keys). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=kotes <code@your-domain.com>

# Optional
# MAX_CODES_PER_HOUR=300      # global cap on sign-in emails, protects your Resend quota
# DATABASE_POOL_MAX=5
